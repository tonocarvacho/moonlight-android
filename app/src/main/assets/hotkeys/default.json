          [{ "label": "Del", "hint": "buffer", "keys": "Ctrl+W W" }, { "label": "NoHL", "keys": "Ctrl+L" }],
          [{ "label": ":", "hint": "cmd", "keys": "Shift+Semicolon" }, { "label": "/", "hint": "search", "keys": "Slash" }]
        ]
      }
    ],
    "footer": [
      [{ "label": "Esc", "hint": "", "keys": "Escape" }, { "label": "Tab", "keys": "Tab" }],
      [{ "label": "⌨", "hint": "kbd", "action": "keyboard" }, { "label": "⏎", "hint": "enter", "keys": "Enter" }]
