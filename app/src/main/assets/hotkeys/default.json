          [{ "label": "↓", "keys": "Down" }, { "label": "PgDn", "keys": "PageDown" }],
          [{ "label": "←", "keys": "Left" }, { "label": "→", "keys": "Right" }],
          [{ "label": "Home", "keys": "Home" }, { "label": "End", "keys": "End" }],
