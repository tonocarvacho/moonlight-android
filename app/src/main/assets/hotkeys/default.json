{
  "_doc": "Hotkey overlay layout. Format and key names: Docs/hotkeys.md",
  "left": {
    "accent": "#8be9fd",
    "pages": [
      {
        "name": "Desk",
        "rows": [
          [{ "label": "Apps", "hint": "rofi", "keys": "Ctrl+Space" }],
          [{ "label": "1", "keys": "Super+U" }, { "label": "2", "keys": "Super+I" }],
          [{ "label": "3", "keys": "Super+O" }, { "label": "4", "keys": "Super+P" }],
          [{ "label": "5", "keys": "Super+2" }, { "label": "♫", "hint": "spotify", "keys": "Super+Y" }],
          [{ "label": "Last", "hint": "window", "keys": "Super+Ctrl+L" }, { "label": "Next", "hint": "window", "keys": "Shift+Alt+T" }],
          [{ "label": "Full", "keys": "Super+Z" }, { "label": "Close", "keys": "Super+Q" }]
        ]
      },
      {
        "name": "Move",
        "rows": [
          [{ "label": "→1", "keys": "Super+Alt+U" }, { "label": "→2", "keys": "Super+Alt+I" }],
          [{ "label": "→3", "keys": "Super+Alt+O" }, { "label": "→4", "keys": "Super+Alt+P" }],
          [{ "label": "Master", "keys": "Super+Ctrl+W" }, { "label": "Swap", "keys": "Super+Escape" }],
          [{ "label": "Float", "keys": "Super+Ctrl+T" }, { "label": "Screen", "keys": "Super+Ctrl+U" }],
          [{ "label": "Wider", "keys": "Super+Ctrl+J" }, { "label": "Thinner", "keys": "Super+Ctrl+K" }],
