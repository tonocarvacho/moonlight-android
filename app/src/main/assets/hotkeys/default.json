          [{ "label": "3", "hint": "tab", "keys": "Alt+R O" }, { "label": "4", "hint": "tab", "keys": "Alt+R P" }],
          [{ "label": "5", "hint": "tab", "keys": "Alt+R J" }, { "label": "Last", "hint": "tab", "keys": "Alt+J" }],
